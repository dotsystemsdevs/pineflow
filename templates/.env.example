# Copy this to .env and fill it in. .env is in .gitignore: never commit it.
#
# Anything named EXPO_PUBLIC_ is built into the app, and anyone who
# downloads it can read it. Only public keys go here.

# Purchases (RevenueCat public SDK keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Analytics (PostHog project key, public by design)
EXPO_PUBLIC_POSTHOG_KEY=

# Supabase, if you use it: the URL and the publishable (anon) key only.
# The service_role key bypasses every security rule. It never goes in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
